<?xml version="1.0" encoding="UTF-8"?>
<bitflow_config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BFML-CXP.xsd">
	<camera>
		<features>
			<standard>CoaXPress</standard>
			<make>Adimec</make>
			<model>Quartz-2A750 Monochrome</model>
			<scan_type>Area Scan</scan_type>
			<xsize>1440</xsize>
			<ysize>1440</ysize>
			<format>1X-2YE</format>
			<bitdepth>12</bitdepth>
			<link_speed>Default</link_speed>
			<acquisition_timeout>1000</acquisition_timeout>
			<cxp_timeout>1000</cxp_timeout>
			<num_links>4</num_links>
			<power_links>
				<link_1>Default</link_1>
				<link_2>Default</link_2>
				<link_3>Default</link_3>
				<link_4>Default</link_4>
			</power_links>
		</features>
		<modes>
			<mode name="Default">
				<comments>Default</comments>
				<io/>
				<bitflow_regs/>
				<device_commands>
					<command interface="camera_gentl" invoke="before_setup">
						<feature>AcquisitionStop</feature>
						<value>1</value>
						<comment>Stop</comment>
					</command>
					<command interface="camera_gentl" invoke="after_setup">
						<feature>AcquisitionStart</feature>
						<value>1</value>
						<comment>Start</comment>
					</command>
				</device_commands>
				<cxp_regs_before>
					<reg comment="Stop">
						<address>0x00008208</address>
						<data>0x00000001</data>
					</reg>
				</cxp_regs_before>
				<cxp_regs_after>
					<reg comment="Start">
						<address>0x00008204</address>
						<data>0x00000001</data>
					</reg>
				</cxp_regs_after>
			</mode>
			<mode name="Trigger">
				<comments>Trigger</comments>
				<io>
					<acquisition_timeout>infinite</acquisition_timeout>
				</io>
				<cxp_regs_before>
					<reg comment="Stop">
						<address>0x00008208</address>
						<data>0x00000001</data>
					</reg>
				</cxp_regs_before>
				<cxp_regs_after>
					<reg comment="SensorPGA_gain">
						<address>0x00008930</address>
						<data>0x00000001</data>
					</reg>
					<reg comment="Width">
						<address>0x00008118</address>
						<data>0x000005A0</data>
					</reg>
					<reg comment="Height">
						<address>0x0000811C</address>
						<data>0x000005A0</data>
					</reg>
					<reg comment="ExposureMode">
						<address>0x00008250</address>
						<data>0x00000001</data>
					</reg>
					<reg comment="PixelFormat">
						<address>0x00008144</address>
						<data>0x01100005</data>
					</reg>
					<reg comment="TriggerSource">
						<address>0x00008238</address>
						<data>0x00010000</data>
					</reg>
					<reg comment="TriggerActivation">
						<address>0x0000823C</address>
						<data>0x00000000</data>
					</reg>
					<reg comment="ExposureSyncTimeCorrection">
						<address>0x0000820C</address>
						<data>0x00000000</data>
					</reg>
					<reg comment="Start">
						<address>0x00008204</address>
						<data>0x00000001</data>
					</reg>
				</cxp_regs_after>
			</mode>
		</modes>
	</camera>
</bitflow_config>
