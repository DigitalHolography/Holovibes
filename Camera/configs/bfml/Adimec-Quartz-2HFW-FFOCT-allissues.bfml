<?xml version="1.0" encoding="UTF-8"?>
<bitflow_config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BFML-CXP.xsd">
	<camera>
		<features>
			<standard>CoaXPress</standard>
			<make>Adimec</make>
			<model>Quartz-2HFW Monochrome</model>
			<scan_type>Area Scan</scan_type>
			<xsize>1440</xsize>
			<ysize>1440</ysize>
			<format>1X-2YE</format>
			<bitdepth>12</bitdepth>
			<link_speed>Default</link_speed>
			<acquisition_timeout>1000</acquisition_timeout>
			<cxp_timeout>1000</cxp_timeout>
			<num_links>4</num_links>
			<power_links>
				<link_1>Default</link_1>
				<link_2>Default</link_2>
				<link_3>Default</link_3>
				<link_4>Default</link_4>
			</power_links>
		</features>
		<modes>
			<mode name="Default">
				<comments>Default</comments>
				<io/>
				<bitflow_regs/>
				<device_commands>
					<command interface="camera_gentl" invoke="before_setup">
						<feature>AcquisitionStop</feature>
						<value>1</value>
						<comment>Stop</comment>
					</command>
					<command interface="camera_gentl" invoke="after_setup">
						<feature>AcquisitionStart</feature>
						<value>1</value>
						<comment>Start</comment>
					</command>
				</device_commands>
				<cxp_regs_before>
					<reg comment="Stop">
						<address>0x00008208</address>
						<data>0x00000001</data>
					</reg>
				</cxp_regs_before>
				<cxp_regs_after>
					<reg comment="Start">
						<address>0x00008204</address>
						<data>0x00000001</data>
					</reg>
				</cxp_regs_after>
			</mode>
			<mode name="Trigger">
				<comments>Trigger</comments>
				<io>
					<acquisition_timeout>infinite</acquisition_timeout>
				</io>
				<device_commands>
					<command interface="camera_gentl" invoke="before_setup">
						<feature>AcquisitionStop</feature>
						<value>1</value>
						<comment>Stop</comment>
					</command>
					<command interface="camera_gentl" invoke="after_setup">
						<feature>Width</feature>
						<value>1440</value>
						<comment>XSize</comment>
					</command>
					<command interface="camera_gentl" invoke="after_setup">
						<feature>Height</feature>
						<value>1440</value>
						<comment>YSize</comment>
					</command>
					<command interface="camera_gentl" invoke="after_setup">
						<feature>PixelFormat</feature>
						<value>Mono12</value>
						<comment>Pixel Format</comment>
					</command>
					<command interface="camera_gentl" invoke="after_setup">
						<feature>TriggerSource</feature>
						<value>IO_Connector</value>
						<comment>Trigger Source</comment>
					</command>
					<command interface="camera_gentl" invoke="after_setup">
						<feature>TriggerActivation</feature>
						<value>FallingEdge</value>
						<comment>Trigger Activation</comment>
					</command>
					<command interface="camera_gentl" invoke="after_setup">
						<feature>ExposureMode</feature>
						<value>TriggerWidth</value>
						<comment>Exposure Mode</comment>
					</command>
					<command interface="camera_gentl" invoke="after_setup">
						<feature>SensorClockFrequency</feature>
						<value>Clock_400_MHz</value>
						<comment>Sensor Clock Frequency</comment>
					</command>
					<command interface="camera_gentl" invoke="after_setup">
						<feature>SensorPGA_gain</feature>
						<value>PGA_gain_12</value>
						<comment>Sensor PGA Gain</comment>
					</command>
					<command interface="camera_gentl" invoke="after_setup">
						<feature>SensorADC_gain</feature>
						<value>8</value>
						<comment>Sensor ADC Gain</comment>
					</command>
					<command interface="camera_gentl" invoke="after_setup">
						<feature>AcquisitionStart</feature>
						<value>1</value>
						<comment>Start</comment>
					</command>
				</device_commands>
			</mode>
		</modes>
	</camera>
</bitflow_config>
